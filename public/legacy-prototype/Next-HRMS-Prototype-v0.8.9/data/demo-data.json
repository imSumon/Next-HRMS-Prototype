  "policies": [
    {
      "name": "Pro-Edge — Attendance status vocabulary",
      "desc": "Legacy uses word-based statuses. Audit found employee shift used as the shift source; calendar assignments were empty in the audited snapshot. Grace/late threshold must be verified from source before migration."
    },
    {
      "name": "Viyellatex — Attendance status vocabulary",
      "desc": "Legacy uses letter-based statuses. Audit found calendar-based shift selection, 30 mismatches against employee shift, and a late classification around 117 seconds in the reviewed example."
    },
    {
      "name": "Pro-Edge — Attendance grace and incomplete punches",
      "desc": "Audit reference: a late label appeared after about 16 minutes; incomplete punch represented as Present plus explanatory text. Preserve as historical behavior evidence, not a universal rule."
    },
    {
      "name": "Viyellatex — Attendance grace and incomplete punches",
      "desc": "Audit reference: zero-grace behavior was observed in the reviewed case; status/pay interpretation requires source validation. Do not silently carry this into the universal product."
    },
    {
      "name": "Policy version history / migration baseline",
      "desc": "Capture source company, source table, effective dates, extracted-at timestamp, approval evidence, and reconciliation result. Exact version dates and values are not all established in the available audit summary."
    }
